# Saksham AI Service — environment variables.
#
# Copy this file to `.env` and fill in the values you need.
# Restart the ai-service after changing any of these (bun run dev --hot in
# mini-services/ai-service will pick up the change automatically).

# --- Master switch ---
# Set to "true" to enable LLM calls. When "false" (or unset), only the mock
# QA database / deterministic templates are used — which is fine for the demo.
LLM_ENABLED=false

# --- Fallback order ---
# The service tries providers in this fixed order and moves to the next one
# automatically on error or timeout: OpenRouter -> NVIDIA -> OpenAI -> custom.
# Set only the key(s) you have; any provider with no key set is skipped.

# --- Provider 1: OpenRouter (tried first) ---
# Get a key from https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: pick any model from https://openrouter.ai/models
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Other good options:
#   OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
#   OPENROUTER_MODEL=google/gemini-flash-1.5
#   OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
#   OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
#   OPENROUTER_MODEL=mistralai/mistral-large

# --- Provider 2: NVIDIA NIM (tried if OpenRouter errors or times out) ---
# Get a key from https://build.nvidia.com (API keys section).
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Only change this if NVIDIA moves their OpenAI-compatible base URL:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Provider 3: OpenAI (legacy fallback, tried after NVIDIA) ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# --- Provider 4: any OpenAI-compatible endpoint (tried last) ---
# Use this for Groq, Together, Fireworks, Ollama, vLLM, etc.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=...
# LLM_MODEL=llama-3.1-70b-versatile

# --- Server-to-server auth for the /summarize-profile REST endpoint ---
# Shared secret the Next.js app must send in the x-ai-service-secret header
# when requesting an AI profile summary right after an assessment submission.
# Leave unset only for local dev with no internet exposure.
# AI_SERVICE_SECRET=change-me-to-a-long-random-string

# Port for the plain-HTTP /summarize-profile endpoint (separate from the
# socket.io port 3003).
# AI_HTTP_PORT=3005
